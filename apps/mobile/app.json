{
  "name": "Krydo",
  "slug": "krydo",
  "version": "0.1.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "scheme": "krydo",
  "userInterfaceStyle": "light",
  "newArchEnabled": true,
  "splash": {
    "image": "./assets/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#0B1220"
  },
  "ios": {
    "supportsTablet": false,
    "bundleIdentifier": "dev.krydo.mobile",
    "associatedDomains": [
      "applinks:krydo.dev"
    ]
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#0B1220"
    },
    "package": "dev.krydo.mobile",
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "krydo",
            "host": "present"
          }
        ],
        "category": [
          "BROWSABLE",
          "DEFAULT"
        ]
      },
      {
        "action": "VIEW",
        "autoVerify": false,
        "data": [
          {
            "scheme": "https",
            "host": "krydo.dev",
            "pathPrefix": "/present"
          }
        ],
        "category": [
          "BROWSABLE",
          "DEFAULT"
        ]
      }
    ]
  },
  "plugins": [
    "expo-router",
    "expo-secure-store",
    [
      "expo-dev-client",
      {
        "launchMode": "most-recent"
      }
    ],
    "expo-font",
    "expo-asset"
  ],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "router": {
      "origin": false
    },
    "eas": {
      "projectId": "00000000-0000-4000-8000-000000000000"
    }
  }
}
