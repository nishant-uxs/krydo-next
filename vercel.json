{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm -f package-lock.json && NPM_CONFIG_PRODUCTION=false npm install --include=optional --include=dev && npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "NPM_CONFIG_PRODUCTION=false npm install --include=optional --include=dev",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://krydo.onrender.com/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://krydo.onrender.com/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://krydo.onrender.com/readyz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
