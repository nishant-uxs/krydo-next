# ----------------------------------------------------------------------------
# Krydo — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# The real `.env` is gitignored; this template is safe to commit.
# Server validates these at startup via server/config.ts (Zod schema).
# ----------------------------------------------------------------------------

# --- Firebase Admin SDK ---
# Two ways to supply the service-account credential — pick ONE:
#
#   Option A (local dev): point at a JSON file on disk. .gitignored.
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
#
#   Option B (production / Render / any ephemeral filesystem): paste the
#   entire service-account JSON as a single-line string. Preferred for
#   cloud deploys because it doesn't require a writable mount.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Stellar / Soroban ---
# Which network the contracts + server target. testnet | mainnet | futurenet.
# After mainnet deploy, this should match contracts/deployment.json ("mainnet").
STELLAR_NETWORK=testnet

# Soroban RPC endpoint. Optional — defaults to deployment.json rpcUrl.
# Mainnet examples:
# SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
# SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.org
# Testnet:
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployer secret key (StrKey, starts with S). This account will:
#   - deploy KrydoAuthority + KrydoCredentials + KrydoAudit contracts
#   - identify the on-chain root authority (G... derived from this secret)
#   - fund RPC simulation / admin reads when the server needs a signing key
# User-facing state changes (add_issuer, issue_credential, revoke, audit
# anchors, role-anchor) are ALWAYS signed in the browser via Stellar Wallets
# Kit after an in-app confirm dialog — not with DEPLOYER_SECRET.
# Create + fund one on testnet:
#   stellar keys generate deployer --network testnet --fund
#   stellar keys secret deployer          # prints the S... secret to paste here
# NEVER put a mainnet-funded key here.
DEPLOYER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Freighter / wallet: switch to the same network as STELLAR_NETWORK / deployment.json
# (TESTNET for dev, MAINNET for production).
# Sign-in uses SEP-53 message signing (not raw ed25519 over UTF-8).

# --- Multi-chain / Reown (EVM) ---
# Get a project id at https://dashboard.reown.com — required for AppKit (web + Android).
# Web Vite client:
# VITE_REOWN_PROJECT_ID=your_reown_cloud_project_id
# Optional server mirror (not required for SIWE verify today):
# REOWN_PROJECT_ID=your_reown_cloud_project_id
# Android: set in apps/android/local.properties
#   reown.projectId=your_reown_cloud_project_id

# --- Split deploy (recommended) ---
# Backend (API + JWT + Firestore + Soroban reads): Render → https://krydo.onrender.com
# Frontend (Vite SPA): Vercel — vercel.json rewrites /api/* → Render.
# Android DEFAULT_API_BASE_URL already points at Render.
#
# Optional: call Render directly from the browser (set on Vercel build env):
# VITE_API_BASE_URL=https://krydo.onrender.com
#
# On Render, allow the Vercel frontend origin, e.g.:
# CORS_ORIGINS=https://krydo-next.vercel.app,https://krydo.onrender.com

# --- Express / Auth ---
# Both must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-random-48-bytes-of-hex
JWT_SECRET=replace-with-different-random-48-bytes-of-hex
PORT=5000

# --- Security ---
# Comma-separated CORS allow-list. Leave empty in dev to allow any origin.
# In production set to your real domain(s), e.g.:
#   CORS_ORIGINS=https://krydo.app,https://app.krydo.app
CORS_ORIGINS=

# Per-IP rate-limiter window (ms) and max requests per window.
# Defaults shown. Lower these if you're seeing abuse.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Optional ---
# NODE_ENV defaults to "development" when running `npm run dev`.
# NODE_ENV=production

# --- Client ---
# The browser uses the Freighter wallet extension (https://freighter.app) for
# connecting + signing. No build-time wallet keys are required.
